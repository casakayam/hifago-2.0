NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL publique d'apps/web (vitrine) — utilisée par apps/admin pour construire des liens
# cross-app (ex: liens de parrainage /r/[code]) qui ne vivent plus dans cette app.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3100

# Optionnelle — géocodage de l'adresse à la création d'un partner (docs/specs/
# 01-admin-creation-partenaire.md §5). Absente : le champ reste manuel, aucun blocage.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Spec 21 — connecteur LobbyPMS (bouton "Tester la connexion" de la fiche établissement). Absente :
# se replie sur https://api.lobbypms.com. Même variable que apps/web/.env.example — jamais le vrai
# LobbyPMS depuis un test automatisé (aucun sandbox n'existe, spec 21 §10 point 1).
LOBBY_API_BASE_URL=
