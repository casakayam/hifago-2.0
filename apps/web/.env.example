NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spec 19 §0 Tranche 1 — paiement Mercado Pago (acompte). Compte développeur Tus Integraciones,
# credentials TEST- en local/sandbox, APP_USR- en prod. Jamais NEXT_PUBLIC_* : ces deux secrets ne
# sont utilisés que côté serveur (apps/web/lib/mercadopago/client.ts, jamais exposés au navigateur
# — Checkout Pro fonctionne par simple redirection vers init_point, aucun SDK client nécessaire).
MERCADOPAGO_ACCESS_TOKEN=
# Secret configuré côté "Notificaciones webhooks" du compte Mercado Pago — sert à vérifier
# x-signature (apps/web/app/api/payments/webhook/route.ts). Sans lui, le webhook refuse tout
# (échec fermé), jamais un webhook accepté sans secret configuré.
MERCADOPAGO_WEBHOOK_SECRET=
