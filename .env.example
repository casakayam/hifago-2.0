# Variables lues par la CLI Supabase (supabase start / db reset) depuis hifago/.env — jamais par
# les apps Next.js elles-mêmes (qui ont leurs propres .env.local, cf. apps/admin/.env.example).
# Copier ce fichier en hifago/.env (gitignoré) et renseigner les vraies valeurs.

# Feature 30 (docs/specs/07-connexion-inscription-complete.md §7) — Client OAuth Google, console
# Cloud "kayam-partner-porta" (réutilisé depuis l'app legacy, hifago.co) ou un nouveau client dédié.
# Ajouter http://127.0.0.1:54321/auth/v1/callback aux "Authorized redirect URIs" du client choisi.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 2026-09-14 — site_url/additional_redirect_urls de supabase/config.toml en env(...) (incident :
# un `config push` a failli écraser le site_url préprod, déjà correct, par la valeur locale). Pas
# des secrets : valeurs de dev local déjà renseignées ci-dessous, à copier telles quelles dans
# hifago/.env. Pour pousser la config vers un AUTRE projet Supabase (préprod, prod), exporter la
# vraie valeur cible dans le shell juste avant `supabase config push` (un export explicite prime
# sur .env, jamais l'inverse).
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3100
SUPABASE_AUTH_REDIRECT_WEB_HTTPS_127=https://127.0.0.1:3100
SUPABASE_AUTH_REDIRECT_ADMIN_HTTP_127=http://127.0.0.1:3101
SUPABASE_AUTH_REDIRECT_ADMIN_HTTPS_127=https://127.0.0.1:3101
SUPABASE_AUTH_REDIRECT_ADMIN_HTTP_LOCALHOST=http://localhost:3101
SUPABASE_AUTH_REDIRECT_ADMIN_HTTPS_LOCALHOST=https://localhost:3101
SUPABASE_AUTH_REDIRECT_ADMIN_HTTP_LOCALHOST_WILDCARD=http://localhost:3101/**
SUPABASE_AUTH_REDIRECT_ADMIN_HTTP_127_WILDCARD=http://127.0.0.1:3101/**
SUPABASE_AUTH_REDIRECT_WEB_HTTP_LOCALHOST=http://localhost:3100
SUPABASE_AUTH_REDIRECT_WEB_HTTPS_LOCALHOST=https://localhost:3100
SUPABASE_AUTH_REDIRECT_WEB_HTTP_LOCALHOST_WILDCARD=http://localhost:3100/**
SUPABASE_AUTH_REDIRECT_WEB_HTTP_127_WILDCARD=http://127.0.0.1:3100/**
