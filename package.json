{
  "name": "hifago-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,admin -c blue,magenta \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/admin\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:concurrency": "for f in tests/concurrency/*.concurrency.mjs; do node \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
